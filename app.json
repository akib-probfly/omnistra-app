{
  "expo": {
    "name": "Zurvis",
    "slug": "Zurvis",
    "version": "1.0.0",
    "scheme": "osaas",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#f4f7fb",
    "androidStatusBar": {
      "backgroundColor": "#f4f7fb",
      "barStyle": "dark-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#f4f7fb",
      "barStyle": "dark-content"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f4f7fb"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.osaas.mobile",
      "infoPlist": {
        "CFBundleDisplayName": "Zurvis",
        "CFBundleName": "Zurvis",
        "NSMicrophoneUsageDescription": "Allow Zurvis to use your microphone for WhatsApp voice calls and voice notes.",
        "NSCameraUsageDescription": "Allow Zurvis to use your camera for WhatsApp calling if required by the device."
      }
    },
    "android": {
      "backgroundColor": "#f4f7fb",
      "package": "com.osaas.mobile",
      "versionCode": 2,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#f4f7fb",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.CAMERA",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.INTERNET",
        "android.permission.BLUETOOTH",
        "android.permission.BLUETOOTH_CONNECT"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f4f7fb",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Zurvis to access your photos to share images and videos.",
          "cameraPermission": "Allow Zurvis to access your camera to send photos and videos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Zurvis to access your photos.",
          "savePhotosPermission": "Allow Zurvis to save images to your photo library.",
          "granularPermissions": ["photo", "video"]
        }
      ],
      "expo-video",
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "enablePngCrunchInReleaseBuilds": true,
            "buildArchs": ["armeabi-v7a", "arm64-v8a"]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "ebcf3a48-25a6-4241-b7d1-d89e0c363502"
      }
    },
    "owner": "akibhasan"
  }
}
